# Frontend .dockerignore
# Ignore everything except what we need for frontend build

# Ignore backend directory completely
backend/

# Ignore root files
Dockerfile
railway.json
*.md
.git
.gitignore

# Ignore node_modules (will be installed)
node_modules
npm-debug.log
yarn-error.log

# Ignore build outputs
.next
out
dist
build

# Ignore environment files
.env
.env.local
.env*.local

# Ignore IDE files
.vscode
.idea
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db
