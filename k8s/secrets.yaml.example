# Example Secrets - DO NOT COMMIT REAL SECRETS!
# Copy this file to secrets.yaml and fill in real values
# Then: kubectl apply -f secrets.yaml
# Or use: kubectl create secret generic taskmaster-secrets --from-env-file=.env

apiVersion: v1
kind: Secret
metadata:
  name: taskmaster-secrets
  namespace: taskmaster-pro
type: Opaque
stringData:
  JWT_SECRET: "your-jwt-secret-here"
  DB_HOST: "mysql-service"
  DB_PORT: "3306"
  DB_NAME: "taskmaster_pro"
  DB_USER: "taskmaster_user"
  DB_PASSWORD: "your-db-password"
  REDIS_HOST: "redis-service"
  REDIS_PORT: "6379"
